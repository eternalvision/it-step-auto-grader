{
  "manifest_version": 3,
  "name": "IT Step Auto Grader",
  "description": "Панель последовательной проверки домашних работ IT Step Academy.",
  "version": "1.0.0",
  "content_scripts": [
    {
      "matches": [
        "https://*.itstep.org/*",
        "https://*.itstep.org.ua/*",
        "https://*.itstep.ua/*"
      ],
      "js": ["index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "IT Step Auto Grader"
  }
}
